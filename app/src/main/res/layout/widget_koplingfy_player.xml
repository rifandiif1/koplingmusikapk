<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_koplingfy_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="@string/cd_album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/img_vinyl_placeholder_1795073960648" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_brand_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="KOPLINGFY HI-FI"
            android:textColor="#FF00E5A0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="#FFB0BBC9"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_btn_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_previous_track"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_btn_primary_bg"
        android:contentDescription="@string/cd_play_pause"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FF0A0B0F" />

    <ImageButton
        android:id="@+id/widget_btn_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_next_track"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFFFFFF" />
</LinearLayout>
